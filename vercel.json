{
    "version": 2,
    "builds": [
        {
            "src": "api/webhook.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/",
            "dest": "/index.html"
        },
        {
            "src": "/setup",
            "dest": "/api/setup.py"
        },
        {
            "src": "/api/webhook",
            "dest": "/api/webhook.py"
        }
    ]
}
